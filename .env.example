# Copie este arquivo para ".env" e ajuste os valores antes de rodar o servidor.
# NUNCA suba o arquivo ".env" de verdade para um repositório público.

PORT=3000
NODE_ENV=development

# Use uma string longa e aleatória em produção (ex: openssl rand -hex 64)
JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio
JWT_EXPIRES_IN=8h

# Origem(ns) do front-end autorizadas a chamar a API, separadas por vírgula.
# As duas primeiras são para testar servindo o app localmente num navegador; as outras
# duas são as origens que o app empacotado com Capacitor usa no Android e no iOS.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost,capacitor://localhost

# Caminho do arquivo do banco SQLite
DB_PATH=./data/secretaria.db
